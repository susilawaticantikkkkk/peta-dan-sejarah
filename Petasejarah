                        <i class="fa-solid fa-play text-goldAccent"></i> Mulai Penjelajahan
                    </button>
                    <button type="button" id="btnViewLeaderboard" onclick="showLeaderboard()" class="bg-amber-700 hover:bg-amber-800 text-white font-bold py-3 px-6 rounded-2xl text-center shadow-md transition flex items-center justify-center gap-2 border border-amber-900">
