        // --- PEMBUATAN PAPAN 6x6 (BOUSTROPHEDON / SNAKE PATTERN) ---
        function initBoard() {
            const boardGrid = document.getElementById('boardGrid');
            boardGrid.innerHTML = '';

            // 36 kotak (Row 0 s.d. Row 5 dalam grid, nomor kotak 36 turun ke 1)
            // Kita buat array 6x6
            for (let r = 0; r < 6; r++) {
                let rowSquares = [];
                for (let c = 0; c < 6; c++) {
                    let squareNum;
                    let revRow = 5 - r; // Row bawah = 5 (no 1-6), row atas = 0 (no 31-36)
                    if (revRow % 2 === 0) {
                        // Genap dari bawah (0, 2, 4): kiri ke kanan
                        squareNum = revRow * 6 + c + 1;
                    } else {
                        // Ganjil dari bawah (1, 3, 5): kanan ke kiri
                        squareNum = revRow * 6 + (6 - c);
                    }
                    rowSquares.push(squareNum);
                }

                rowSquares.forEach(num => {
                    const sqDiv = document.createElement('div');
                    sqDiv.id = `square-${num}`;
                    sqDiv.className = "relative bg-[#fdf6e2] border border-[#c2b280] rounded-xl p-1 flex flex-col justify-between items-center aspect-square text-[10px] sm:text-xs font-bold text-woodDark shadow-sm";
                    
                    // Label nomor kotak
                    let iconHtml = `<span class="absolute top-1 left-1 text-[9px] text-gray-500 font-bold">${num}</span>`;
                    
                    // Keterangan khusus tangga / ular
                    let specialBadge = "";
                    if (snakesAndLadders[num]) {
                        if (snakesAndLadders[num].type === 'ladder') {
                            specialBadge = `<span class="text-green-700 text-[9px] mt-2 font-extrabold" title="Tangga Naik">📈${snakesAndLadders[num].to}</span>`;
                            sqDiv.classList.add('bg-green-50');
                        } else {
                            specialBadge = `<span class="text-red-700 text-[9px] mt-2 font-extrabold" title="Ular Turun">📉${snakesAndLadders[num].to}</span>`;
                            sqDiv.classList.add('bg-red-50');
                        }
                    } else if (num === 36) {
                        specialBadge = `<span class="text-goldAccent text-xs mt-2" title="Finish">🏁</span>`;
                        sqDiv.classList.add('bg-amber-100');
                    } else {
                        specialBadge = `<span class="text-gray-400 text-[9px] mt-2">🏰</span>`;
                    }

                    sqDiv.innerHTML = iconHtml + specialBadge + `<div id="tokens-${num}" class="flex gap-1 items-center justify-center min-h-[16px]"></div>`;
                    boardGrid.appendChild(sqDiv);
                });
            }
            renderTokens();
        }

