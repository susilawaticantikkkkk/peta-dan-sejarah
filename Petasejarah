                        <label class="block text-sm font-bold text-red-700 mb-1">
                            <i class="fa-solid fa-chess-pawn"></i> Pemain 1 (Pion Merah)
                        </label>
                        <input type="text" id="player1Name" required placeholder="Nama Pemain 1" 
                            class="w-full px-3 py-2 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-red-500 bg-white text-sm">
                    </div>
                    <div class="bg-amber-100/70 p-4 rounded-2xl border border-amber-300">
                        <label class="block text-sm font-bold text-blue-700 mb-1">
                            <i class="fa-solid fa-chess-pawn"></i> Pemain 2 (Pion Biru)
                        </label>
                        <input type="text" id="player2Name" required placeholder="Nama Pemain 2" 
