            const modal = document.getElementById('eventModal');
            const contentArea = document.getElementById('modalContentArea');
            const actionArea = document.getElementById('modalActionArea');

            const isCorrect = selectedIndex === currentQuiz.answer;
            let currentPlayer = gameState.turn === 1 ? gameState.player1 : gameState.player2;

            if (isCorrect) {
                gameState.correctAnswers++;
                playSound('success');
                currentPlayer.pos = Math.min(36, currentPlayer.pos + 1);
                renderTokens();
                addLog(`${currentPlayer.name} MENJAWAB BENAR kuis sejarah! Mendapat bonus maju ke kotak ${currentPlayer.pos}.`);

                contentArea.innerHTML = `
                    <div class="bg-green-100 border-2 border-green-400 p-4 rounded-2xl text-center">
                        <div class="text-green-800 font-bold text-base mb-1"><i class="fa-solid fa-circle-check"></i> Jawaban Benar!</div>
                        <p class="text-xs text-gray-700 mb-2">${currentQuiz.explanation}</p>
                        <p class="text-xs font-bold text-green-700">Bonus: Pion maju +1 langkah!</p>
                    </div>
                `;
            } else {
                playSound('error');
                addLog(`${currentPlayer.name} menjawab salah kuis sejarah.`);
                contentArea.innerHTML = `
                    <div class="bg-red-100 border-2 border-red-300 p-4 rounded-2xl text-center">
                        <div class="text-red-800 font-bold text-base mb-1"><i class="fa-solid fa-circle-xmark"></i> Jawaban Kurang Tepat!</div>
                        <p class="text-xs text-gray-700 mb-2">Jawaban yang benar adalah: <b>${currentQuiz.options[currentQuiz.answer]}</b></p>
                        <p class="text-xs text-gray-600">${currentQuiz.explanation}</p>
                    </div>
                `;
            }

            actionArea.innerHTML = `
                <button onclick="closeQuizModal(${currentPlayer.pos === 36})" class="btn-wood text-white font-bold py-2.5 px-6 rounded-xl shadow-md text-sm">
                    Lanjutkan Permainan <i class="fa-solid fa-arrow-right ml-1"></i>
                </button>
            `;
        }

        function closeQuizModal(isWin) {
            document.getElementById('eventModal').classList.add('hidden');
            if (isWin) {
                let currentPlayer = gameState.turn === 1 ? gameState.player1 : gameState.player2;
                triggerGameOver(currentPlayer);
            } else {
                switchTurn();
            }
        }

        function switchTurn() {
            gameState.turn = gameState.turn === 1 ? 2 : 1;
            updateGameUI();
            document.getElementById('btnRoll').disabled = false;
            document.getElementById('diceMessage').innerText = "Silakan kocok dadu!";
        }

        // --- GAME OVER & LEADERBOARD ---
        function triggerGameOver(winner) {
            gameState.gameOver = true;
            playSound('win');
            addLog(`PERMAINAN SELESAI! ${winner.name} keluar sebagai pemenang penjelajahan!`);

            document.getElementById('gameScreen').classList.add('hidden');
            document.getElementById('gameOverScreen').classList.remove('hidden');

            document.getElementById('winnerAnnouncement').innerText = `${winner.name} (${winner.color === 'red' ? 'Pion Merah' : 'Pion Biru'}) Menangkan Ekspedisi!`;
            document.getElementById('statTeam').innerText = gameState.team;
            document.getElementById('statWinner').innerText = winner.name;
            document.getElementById('statRolls').innerText = gameState.totalRolls;

            let accuracy = gameState.totalQuizzes > 0 ? Math.round((gameState.correctAnswers / gameState.totalQuizzes) * 100) : 0;
            document.getElementById('statAccuracy').innerText = `${accuracy}% (${gameState.correctAnswers}/${gameState.totalQuizzes} benar)`;
        }

        function saveScoreAndRestart() {
            let leaderboards = JSON.parse(localStorage.getItem('bentengNusantaraLB') || '[]');
            let accuracy = gameState.totalQuizzes > 0 ? Math.round((gameState.correctAnswers / gameState.totalQuizzes) * 100) : 0;
            
            let winnerName = gameState.player1.pos === 36 ? gameState.player1.name : gameState.player2.name;

            leaderboards.push({
                winner: winnerName,
                team: gameState.team,
                rolls: gameState.totalRolls,
                accuracy: accuracy,
                date: new Date().toLocaleDateString('id-ID')
            });

            // Urutkan berdasarkan lemparan paling sedikit, lalu akurasi tertinggi
            leaderboards.sort((a, b) => {
                if (a.rolls !== b.rolls) return a.rolls - b.rolls;
                return b.accuracy - a.accuracy;
            });

            // Simpan top 10
            localStorage.setItem('bentengNusantaraLB', JSON.stringify(leaderboards.slice(0, 10)));

            // Tampilkan leaderboard
            document.getElementById('gameOverScreen').classList.add('hidden');
            document.getElementById('leaderboardScreen').classList.remove('hidden');
            renderLeaderboardTable();
        }

        function renderLeaderboardTable() {
            let leaderboards = JSON.parse(localStorage.getItem('bentengNusantaraLB') || '[]');
            const tbody = document.getElementById('leaderboardTableBody');
            tbody.innerHTML = '';

            if (leaderboards.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-gray-500">Belum ada data skor tersimpan.</td></tr>`;
                return;
            }

            leaderboards.forEach((item, index) => {
                let badgeColor = index === 0 ? 'text-yellow-600 bg-yellow-100' : index === 1 ? 'text-gray-600 bg-gray-100' : index === 2 ? 'text-amber-700 bg-amber-100' : 'text-gray-700';
                tbody.innerHTML += `
                    <tr class="border-b border-amber-200 hover:bg-amber-50">
                        <td class="p-3 text-center font-bold">
                            <span class="px-2 py-1 rounded-full ${badgeColor}">#${index + 1}</span>
                        </td>
                        <td class="p-3">
                            <div class="font-bold text-woodDark">${item.winner}</div>
                            <div class="text-[11px] text-gray-500">${item.team}</div>
                        </td>
                        <td class="p-3 text-center font-semibold text-amber-800">${item.rolls} lemparan (${item.accuracy}% kuis)</td>
                        <td class="p-3 text-right text-xs text-gray-500">${item.date}</td>
                    </tr>
                `;
            });
        }
    </script>
</body>
</html>
