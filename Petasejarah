        // --- MEKANISME LEMPAR DADU & JALAN ---
        function rollDice() {
            if (gameState.gameOver) return;

            const btnRoll = document.getElementById('btnRoll');
            const diceBox = document.getElementById('diceBox');
            const diceMessage = document.getElementById('diceMessage');

            btnRoll.disabled = true;
            diceBox.classList.add('shake-anim');
            playSound('dice');
            diceMessage.innerText = "Mengocok dadu perjuangan...";

            let rollCount = 0;
            let rollInterval = setInterval(() => {
                let tempRoll = Math.floor(Math.random() * 6) + 1;
                diceBox.innerText = ['⚀','⚁','⚂','⚃','⚄','⚅'][tempRoll - 1];
                rollCount++;

                if (rollCount > 10) {
                    clearInterval(rollInterval);
                    diceBox.classList.remove('shake-anim');
                    
                    let finalRoll = Math.floor(Math.random() * 6) + 1;
                    diceBox.innerText = ['⚀','⚁','⚂','⚃','⚄','⚅'][finalRoll - 1];
                    diceMessage.innerText = `Dapat angka: ${finalRoll}!`;
                    
                    gameState.totalRolls++;
                    processPlayerMove(finalRoll);
                }
            }, 80);
        }

        function processPlayerMove(steps) {
            let currentPlayer = gameState.turn === 1 ? gameState.player1 : gameState.player2;
            let oldPos = currentPlayer.pos;
            let newPos = oldPos + steps;

            if (newPos > 36) {
                // Pas atau mantul / pas di 36
                newPos = 36;
            }

            currentPlayer.pos = newPos;
            renderTokens();
            playSound('move');
            addLog(`${currentPlayer.name} melangkah dari ${oldPos} ke ${newPos}.`);

            // Cek Kemenangan
            if (newPos === 36) {
                triggerGameOver(currentPlayer);
                return;
            }

            // Jeda sebentar sebelum trigger kuis atau ular/tangga
            setTimeout(() => {
                checkSpecialSquareOrQuiz(currentPlayer, newPos);
            }, 600);
        }

